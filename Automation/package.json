{
  "name": "quantarra-qa-automation",
  "version": "1.0.0",
  "description": "Standalone Playwright QA automation for Quantarra platform",
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:dev": "cross-env ENV=dev npx playwright test",
    "test:staging": "cross-env ENV=staging npx playwright test",
    "test:prod": "cross-env ENV=prod npx playwright test",
    "smoke": "npx playwright test --project=smoke-web --project=smoke-api",
    "smoke:suite": "npx playwright test --project=smoke-suite",
    "api:suite": "npx playwright test --project=api-suite",
    "api:auth": "npx playwright test tests/api-suite/auth.spec.ts --project=api-suite",
    "api:users": "npx playwright test tests/api-suite/users.spec.ts --project=api-suite",
    "api:frameworks": "npx playwright test tests/api-suite/frameworks.spec.ts --project=api-suite",
    "api:audits": "npx playwright test tests/api-suite/audits.spec.ts --project=api-suite",
    "api:policies": "npx playwright test tests/api-suite/policies.spec.ts --project=api-suite",
    "api:evidence": "npx playwright test tests/api-suite/evidence.spec.ts --project=api-suite",
    "smoke:all": "npx playwright test --project=smoke-suite --project=smoke-web --project=smoke-mc --project=smoke-audit --project=smoke-api",
    "smoke:web": "npx playwright test --project=smoke-web",
    "smoke:mc": "npx playwright test --project=smoke-mc",
    "smoke:audit": "npx playwright test --project=smoke-audit",
    "smoke:api": "npx playwright test --project=smoke-api",
    "smoke:staging": "cross-env ENV=staging npx playwright test --project=smoke-web --project=smoke-mc --project=smoke-audit --project=smoke-api",
    "smoke:prod": "cross-env ENV=prod npx playwright test --project=smoke-web --project=smoke-mc --project=smoke-audit --project=smoke-api",
    "shakeout:poc": "cross-env ENV=poc npx playwright test --project=daily-shakeout",
    "shakeout:prod": "cross-env ENV=prod npx playwright test --project=daily-shakeout",
    "shakeout:all": "npm run shakeout:poc && npm run shakeout:prod",
    "regression": "cross-env ENV=staging RUN_MODE=regression npx playwright test --project=regression",
    "regression:staging": "cross-env ENV=staging RUN_MODE=regression npx playwright test --project=regression",
    "regression:poc": "cross-env ENV=poc RUN_MODE=regression npx playwright test --project=regression",
    "regression:prod": "cross-env ENV=prod RUN_MODE=regression npx playwright test --project=regression",
    "test:headed": "npx playwright test --headed",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "report:html": "npx playwright show-report",
    "report:excel": "npx tsx src/reporters/generate-excel-report.ts",
    "jira:create-bug": "npx tsx src/jira/create-bug.ts",
    "setup": "npx playwright install chromium"
  },
  "dependencies": {
    "@playwright/test": "1.48.0",
    "cross-env": "7.0.3",
    "dotenv": "16.4.5",
    "exceljs": "4.4.0",
    "nodemailer": "^6.9.14",
    "tsx": "4.19.0"
  },
  "devDependencies": {
    "@types/node": "20.14.0",
    "@types/nodemailer": "^6.4.15",
    "typescript": "5.5.4",
    "xlsx": "^0.18.5"
  }
}
