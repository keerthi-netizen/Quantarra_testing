# ============================================
# Quantarra QA Automation — Environment Config
# ============================================
# Copy this file to .env and fill in your values.
# Switch environments via ENV variable: dev | staging | prod

# Active environment (dev / staging / prod)
ENV=dev

# ---- DEV Environment ----
DEV_BASE_URL=https://dev.quantarra.com
DEV_MC_URL=https://dev.quantarra.com:4002
DEV_AUDIT_URL=https://dev.quantarra.com:4003
DEV_API_URL=https://dev.quantarra.com/api/v1

# ---- STAGING Environment ----
STAGING_BASE_URL=https://stg.quantarra.com
STAGING_MC_URL=https://stg.quantarra.com:4002
STAGING_AUDIT_URL=https://stg.quantarra.com:4003
STAGING_API_URL=https://stg.quantarra.com/api/v1

# ---- PROD Environment ----
PROD_BASE_URL=https://app.quantarra.com
PROD_MC_URL=https://mc.quantarra.com
PROD_AUDIT_URL=https://audit.quantarra.com
PROD_API_URL=https://app.quantarra.com/api/v1

# ---- Test Credentials ----
# Admin user (full access — Super User on staging)
ADMIN_EMAIL=keerthi@quantarra.io
ADMIN_PASSWORD=Quantarra2026!

# Manager user (mid-privilege)
MANAGER_EMAIL=manager@acme.com
MANAGER_PASSWORD=Quantarra2026!

# Contributor user (restricted)
CONTRIBUTOR_EMAIL=contributor@acme.com
CONTRIBUTOR_PASSWORD=Quantarra2026!

# MC Super User
MC_ADMIN_EMAIL=keerthi@quantarra.io
MC_ADMIN_PASSWORD=Quantarra2026!

# ---- Jira Integration ----
JIRA_BASE_URL=https://quantarra.atlassian.net
JIRA_PROJECT_KEY=PRJAT
JIRA_EMAIL=your-email@quantarra.io
JIRA_API_TOKEN=your-jira-api-token
JIRA_ASSIGNEE_ID=

# ---- Report Settings ----
REPORT_OUTPUT_DIR=./reports
REPORT_INCLUDE_SCREENSHOTS=true
